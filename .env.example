# WE — exemplo de configuração local. NÃO contém valores reais.
# `python scripts/dev.py bootstrap` gera `.env` (ignorado pelo Git) com segredos aleatórios.
WE_ENV=development
WE_PG_HOST=localhost
WE_PG_PORT=55432
WE_PG_DB=we
WE_PG_ADMIN_USER=we_admin
WE_PG_ADMIN_PASSWORD=__GERADO_PELO_BOOTSTRAP__
WE_PG_APP_PASSWORD=__GERADO_PELO_BOOTSTRAP__
WE_PG_WORKER_PASSWORD=__GERADO_PELO_BOOTSTRAP__
WE_NATS_URL=nats://localhost:4222
WE_REDIS_URL=redis://localhost:6379/0
WE_REDIS_PASSWORD=__GERADO_PELO_BOOTSTRAP__
WE_S3_ENDPOINT=http://localhost:8333
WE_S3_ACCESS_KEY=__GERADO_PELO_BOOTSTRAP__
WE_S3_SECRET_KEY=__GERADO_PELO_BOOTSTRAP__
WE_S3_BUCKET=we-evidence
WE_OIDC_ISSUER=https://dev-idp.we.local
WE_OIDC_AUDIENCE=we-api
