{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.we.local/events/iam.actor_created.v1.schema.json",
  "title": "iam.actor_created v1",
  "description": "Ator registado.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "actor_type": {
      "enum": [
        "human",
        "service",
        "ai_agent"
      ]
    },
    "clearance": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ]
    }
  },
  "required": [
    "actor_type",
    "clearance"
  ]
}
