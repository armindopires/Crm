{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.we.local/events/iam.policy_created.v1.schema.json",
  "title": "iam.policy_created v1",
  "description": "Política ABAC publicada (versão imutável).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "effect": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "version",
    "effect",
    "actions"
  ]
}
