{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.we.local/event-envelope.v1.schema.json",
  "title": "WE Event Envelope v1",
  "description": "Envelope comum a todos os eventos da WE publicados no EventBus. O payload é validado pelo schema do event_type/schema_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "tenant_id", "aggregate_type", "aggregate_id",
               "aggregate_version", "actor_type", "occurred_at", "recorded_at", "correlation_id", "chain_seq",
               "classification", "payload", "metadata", "previous_hash", "event_hash"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "schema_version": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_type": {"type": "string"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "context_frame_id": {"type": ["string", "null"], "format": "uuid"},
    "actor_id": {"type": ["string", "null"], "format": "uuid"},
    "actor_type": {"enum": ["human", "service", "ai_agent", "system"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "trace_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": ["string", "null"]},
    "chain_seq": {"type": "integer", "minimum": 1},
    "classification": {"enum": ["public", "internal", "confidential", "restricted", "secret"]},
    "payload": {"type": "object"},
    "metadata": {"type": "object"},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
